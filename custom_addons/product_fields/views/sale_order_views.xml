<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_line_view_field_product_brand" model="ir.ui.view">
        <field name="name">sale.order.line.view.field.product.brand</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="brand"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_view_field_is_prime_customer" model="ir.ui.view">
        <field name="name">sale.order.form.view.field.is.prime.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_prime_customer" invisible="is_prime_customer != True"/>
            </xpath>
        </field>
    </record>
</odoo>