<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="add_associated_products_bool_field_view" model="ir.ui.view">
        <field name="name">add.associated.products.bool.field.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="add_associated_products"/>
            </xpath>
        </field>
    </record>
</odoo>