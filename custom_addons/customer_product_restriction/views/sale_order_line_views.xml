<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_line_view_form_product_id_domain_restriction" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.product.domain.restriction</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="partner_allowed_product_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="domain">
                    (company_id and ['|', ('company_id', '=', False), ('company_id', 'parent_of', [company_id])] or
                    ['|', ('company_id', '=', False), ('company_id', 'parent_of', '')]) + ([('sale_ok', '=', True)]) + ([('id','in',partner_allowed_product_ids)])
<!--                    [('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', 'parent_of', parent.company_id), ('id','in',partner_allowed_product_ids)]-->

<!--                    [('id','in',partner_allowed_product_ids)]-->
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>