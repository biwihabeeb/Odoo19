<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_view_form_customer_product_restiction_fields" model="ir.ui.view">
        <field name="name">res.partner.view.form.customer.product.restiction.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="allowed_product_ids" widget="many2many_tags"/>
                <field name="order_limit"/>
            </xpath>
        </field>
    </record>
</odoo>