<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_form_view_field_allowed_customer_tag_ids" model="ir.ui.view">
        <field name="name">res.partner.form.view.field.allowed.customer.tag.ids</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group/field[@name='category_id']" position="after">
                <field name="allowed_tag_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>