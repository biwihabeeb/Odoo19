<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_view_allowed_categories" model="ir.ui.view">
        <field name="name">sale.order.view.allowed.categories</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="allowed_tag_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_form_view_filter_customer_on_tags" model="ir.ui.view">
        <field name="name">sale.order.form.view.filter.customer.on.tags</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">
                    ['|', ('company_id', '=', False), ('company_id',
                    '=',company_id), ('category_id','in',allowed_tag_ids)]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>