<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_form_view_field_restricted_combo_products" model="ir.ui.view">
        <field name="name">sale.order.form.view.field.restricted.combo.products</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="restricted_product_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>