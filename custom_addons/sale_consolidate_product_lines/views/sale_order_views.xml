<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_consolidate_action_button" model="ir.ui.view">
        <field name="name">sale.order.consolidate.action.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_consolidate_duplicate_product_line" type="object" class="btn-primary"
                        string="Merge Duplicate Products" id="action_consolidate_duplicate_product_line"/>
            </xpath>
        </field>
    </record>
</odoo>