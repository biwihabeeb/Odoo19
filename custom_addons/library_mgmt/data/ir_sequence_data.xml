<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="sequence_book" model="ir.sequence">
        <field name="name">Book ID</field>
        <field name="code">library.books</field>
        <field name="prefix">BOOK</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="sequence_checkout" model="ir.sequence">
        <field name="name">Checkout ID</field>
        <field name="code">library.checkouts</field>
        <field name="prefix">CHKOUT</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>