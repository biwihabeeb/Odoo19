<?xml version="1.0" encoding="utf-8"?>

<odoo>
   <data>
       <record model="ir.module.category" id="module_category_library_mgmt">
           <field name="name">library</field>
       </record>
       <record model="res.groups.privilege" id="res_groups_privilege_library_mgmt">
           <field name="name">Library Management</field>
           <field name="category_id" ref="library_mgmt.module_category_library_mgmt"/>
       </record>

<!--       Librarian-->
       <record id="group_librarian" model="res.groups">
           <field name="name">Librarian</field>
           <field name="privilege_id" ref="res_groups_privilege_library_mgmt"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
       </record>

<!--       Library Assistant-->
       <record id="group_library_assistant" model="res.groups">
           <field name="name">Library Assistant</field>
           <field name="privilege_id" ref="res_groups_privilege_library_mgmt"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>
   </data>
</odoo>