<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_library_book_borrow_report_view" model="ir.actions.act_window">
        <field name="name">Generate book borrow report</field>
        <field name="res_model">library.book.borrow.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="library_book_borrow_report_form_view" model="ir.ui.view">
        <field name="name">library.book.borrow.report.view.fomr</field>
        <field name="model">library.book.borrow.report</field>
        <field name="arch" type="xml">

            <form>
                <h3>Filter by:</h3>
                <group>
                    <field name="member_id" string="Member name"/>
                    <field name="author_id" string="Author"/>
                    <field name="book_id" string="Book"/>
                    <field name="checkout_date" string="Checkout Date"/>
                    <field name="return_date" string="Return Date"/>
                    <field name="publisher_id" string="Publisher"/>
                    <field name="genre_id" string="Genre"/>
                    <field name="sort" string="Sort By" Placeholder="Leave blank to sort by default"/>
                </group>
                <footer>
                    <button name="print_borrow_report" type="object" string="Print PDF" class="oe_highlight"/>
                    <button name="print_borrow_report_xlsx" type="object" string="Print XLSX" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

