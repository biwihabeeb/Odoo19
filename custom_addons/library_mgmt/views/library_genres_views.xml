<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_library_mgmt_genre" model="ir.actions.act_window">
        <field name="name">Genres</field>
        <field name="res_model">library.genres</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Genres Here</p>
        </field>
    </record>

    <!--  List View  -->
    <record id="genre_view_list" model="ir.ui.view">
        <field name="name">library.genres.list</field>
        <field name="model">library.genres</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <!--    Form View -->
    <record id="genre_view_form" model="ir.ui.view">
        <field name="name">library.genres.form</field>
        <field name="model">library.genres</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>
</odoo>