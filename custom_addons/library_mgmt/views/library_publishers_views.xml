<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_library_mgmt_publisher" model="ir.actions.act_window">
        <field name="name">Publishers</field>
        <field name="res_model">library.publishers</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Publisher records</p>
        </field>
    </record>

        <!--  List View  -->
    <record id="publisher_view_list" model="ir.ui.view">
        <field name="name">library.publishers.list</field>
        <field name="model">library.publishers</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="publisher_address"/>
                <field name="books_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
    <!--    Form View -->
    <record id="genre_view_form" model="ir.ui.view">
        <field name="name">library.publishers.form</field>
        <field name="model">library.publishers</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="publisher_address" />
                    <field name="books_ids" />
                    <!--                    <field name="book_status" />-->
                    <!--                    <field name="book_author" />-->
                    <!--                    <field name="book_price" />-->
                    <!--                    <field name="book_cost" />-->
                </group>
            </form>
        </field>
    </record>
</odoo>