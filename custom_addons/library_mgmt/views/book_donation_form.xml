                                        <!--                                             style="display: flex; flex-wrap: wrap; gap: 6px;-->
                                        <!--                                                     margin-top: 24px; border: 1px solid #212529; padding: 6px; border-radius: 8px; margin-left: 7px;"-->

                                        <!--                                            </div>-->
                                        <div class="mb-3">
                                            <label class="form-label">Publisher Name</label>
                                            <input type="text" name="publisher" class="form-control"
                                                   required="required"/>
                                        </div>
                                        <div class="mb-3 upload_form form-group">
                                            <label class="col-form-label" for="attachment">Upload Book Image</label>
                                            <input class="form-control" id="attachments" type="file"
                                                   name="attachment"
                                                   accept="image/*"/>
                                        </div>
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3 d-grid">
                                            <button type="submit" class="btn btn-primary">Submit</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
            <script type="text/javascript" src="/library_mgmt/static/src/js/multi_select_genres.js"/>

        </template>

        <template id="donation_success_template" name="Book record created">
            <t t-call="website.layout">
                <div class="container">
                    <h3>Your Donation Request is Successful! Thank You for your Contribution</h3>
                </div>
            </t>
        </template>

        <record id="menu_donate_book_form" model="website.menu">
            <field name="name">Donate Books</field>
            <field name="url">website/book_donate/form</field>
            <field name="parent_id" ref="website.main_menu"/>

        </record>
    </data>
