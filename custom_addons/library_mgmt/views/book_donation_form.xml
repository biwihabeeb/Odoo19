<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="book_donation_form_template" name="Book Donation Form">
            <t t-call="website.layout">
                <section class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Enter Book Details</h3>
                                    <form action="/website/book_donate/create" enctype="multipart/form-data"
                                          method="post">
                                        <div class="mb-3">
                                            <label class="form-label">Book Title</label>
                                            <input type="text" name="book_title" required="required"
                                                   class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Author Name</label>
                                            <input type="text" name="author_name" required="required"
                                                   class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">ISBN Code</label>
                                            <input type="text" name="isbn" required="required"
                                                   class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Genres</label>
                                            <select id="genres"
                                                    class="form-control s_website_form_input"
                                                    name="genres"
                                                    multiple="multiple">
                                                <t t-foreach="genres" t-as="genre">
                                                    <option t-att-value="genre.id">
                                                        <t t-esc="genre.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
