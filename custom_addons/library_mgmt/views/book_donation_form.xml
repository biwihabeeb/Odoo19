<!--                                                <t t-foreach="request.env['crm.tag'].sudo().search([])" t-as="tag">-->
<!--                                                    <option t-att-value="tag.id">-->
<!--                                                        <t t-esc="tag.name"/>-->
<!--                                                    </option>-->
<!--                                                </t>-->
<!--                                            </select>-->
<!--                                            <div class="tag-pill-container col-6 form-control s_website_form_input"-->
<!--                                                 style="display: flex; flex-wrap: wrap; gap: 6px;-->
<!--                margin-top: 24px; border: 1px solid #212529; padding: 6px; border-radius: 8px; margin-left: 7px;">-->
<!--                                                &lt;!&ndash; Pills for selected tags will appear here &ndash;&gt;-->
<!--                                            </div>-->
<!--                                        </div>-->
