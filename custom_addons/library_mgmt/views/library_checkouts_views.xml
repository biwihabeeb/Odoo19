<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_library_mgmt_checkout" model="ir.actions.act_window">
        <field name="name">Checkouts</field>
        <field name="res_model">library.checkouts</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create Checkout records</p>
        </field>
    </record>

    <!--  List View  -->
    <record id="checkout_view_list" model="ir.ui.view">
        <field name="name">library.checkouts.list</field>
        <field name="model">library.checkouts</field>
        <field name="arch" type="xml">
            <list decoration-danger="checkout_status == 'overdue'" decoration-success="checkout_status == 'returned'">
                <field name="name"/>
                <field name="checkout_member_name_id"/>
                <field name="checkout_lines_ids" widget="many2many_tags" string="Books"/>
                <field name="checkout_status"/>
                <field name="checkout_return_due"/>
                <field name="create_uid"/>
                <field name="if_late_return"/>
            </list>
        </field>
    </record>

    <!--    Form View -->
    <record id="checkout_view_form" model="ir.ui.view">
        <field name="name">library.checkouts.form</field>
        <field name="model">library.checkouts</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="checkout_status" widget="statusbar" statusbar_visible="checked_out,returned,overdue"/>
                    <button name="button_checkout" type="object" string="Checkout" class="oe_highlight" invisible="checkout_status == 'checked_out' or checkout_status == 'overdue' or checkout_status == 'returned'"/>
                    <button name="button_cancel" type="object" string="Cancel" invisible="checkout_status == False"/>
                    <button name="button_return" type="object" string="Return" invisible="checkout_status == 'returned' or checkout_status == False"/>
                    <button name="create_invoice" type="object" string="Create Invoice" class="oe_highlight" invisible="checkout_status == 'checked_out' or checkout_status == False"/>
                </header>
                <div class="alert alert-warning" role="alert" invisible="late_return_limit_warning_text == False">
                    <field name="late_return_limit_warning_text" class="fw-bold" readonly="1"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" string="Invoice(s)" icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoice(s)"/>
                        </button>
                    </div>
                    <field name="payment_status" widget="badge" class="oe_avatar" decoration-success="payment_status == 'paid'"/>
                    <h2><field name="name"/></h2>
                    <group>
                        <field name="checkout_member_name_id"/>
                        <field name="checkout_member_contact"/>
                        <field name="create_uid"/>
                        <field name="checkout_date"/>
                        <field name="checkout_return_due"/>
                        <field name="checkout_returned"/>
                        <field name="checkout_status"/>
                        <field name="checkout_member_email"/>
<!--                        <field name="checkout_book_status"/>-->
                        <field name="checkout_penalty"/>
<!--                         invisible="payment_status != 'paid'"-->
                    </group>
                    <notebook>
                        <page string="Add Books">
                            <field name="checkout_lines_ids" readonly="checkout_status == 'checked_out'">
                                <list editable="bottom">
                                    <field name="book_id"/>
                                    <field name="book_author_id"/>
                                    <field name="book_genre_ids" widget="many2many_tags" readonly="1"/>
<!--                                    <field name="borrow_count"/>-->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

</odoo>