<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_fleet_service_order" model="ir.actions.act_window">
        <field name="name">Service Order</field>
        <field name="res_model">fleet.service.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your records</p>
        </field>
    </record>

    <record id="fleet_service_order_view_list" model="ir.ui.view">
        <field name="name">fleet.service.order.view.list</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="technician_id"/>
                <field name="service_date"/>
                <field name="state"/>
                <field name="part_ids" widget="many2many_tags"/>
                <field name="checklist_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="fleet_service_order_view_form" model="ir.ui.view">
        <field name="name">fleet.service.order.view.form</field>
        <field name="model">fleet.service.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done,cancel"/>
                    <button name="button_confirm" type="object" string="Confirm" class="oe_highlight"/>
                    <button name="button_start_service" type="object" string="Start Service" class="btn_primary"
                            invisible="state == 'draft'"/>
                    <button name="button_cancel" type="object" string="Cancel" class="btn_secondary"/>
                    <button name="button_generate_checklist" type="object" string="Generate Checklist"
                            class="oe_highlight" invisible="state not in ['confirmed','in_progress','done']"/>
                </header>
                <sheet>
                    <h2>
                        <field name="name">Name</field>
                    </h2>
                    <group>
                        <field name="technician_id"/>
                        <field name="allowed_vehicle_ids" widget="many2many_tags" invisible="1"/>
                        <field name="vehicle_id" domain="[('service_blocked','!=',True),('id','in',allowed_vehicle_ids)]"/>
                        <field name="service_date"/>
                        <field name="labour_cost"/>
                        <field name="parts_total"/>
                        <field name="grand_total"/>
                        <field name="checklist_progress"/>
                        <field name="type_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page id="parts" string="Parts">
                            <field name="part_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>
                        <page id="checklist" string="Checklist">
                            <field name="checklist_ids">
                                <list editable="bottom">
                                    <field name="task_name"/>
                                    <field name="is_done"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


</odoo>