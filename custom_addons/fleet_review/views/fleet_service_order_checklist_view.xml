<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_fleet_service_order_checklist" model="ir.actions.act_window">
        <field name="name">Checklist</field>
        <field name="res_model">fleet.service.order.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your records</p>
        </field>
    </record>

    <record id="fleet_service_order_checklist_view_list" model="ir.ui.view">
        <field name="name">fleet.service.order.checklist.view.list</field>
        <field name="model">fleet.service.order.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_id"/>
                <field name="task_name"/>
                <field name="is_done"/>
            </list>
        </field>
    </record>

    <record id="fleet_service_order_checklist_view_form" model="ir.ui.view">
        <field name="name">fleet.service.order.checklist.view.form</field>
        <field name="model">fleet.service.order.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_id"/>
                        <field name="task_name"/>
                        <field name="is_done"/>
                        <field name="note"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>