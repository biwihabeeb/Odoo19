<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_form_view_pos_purchase_amount_cap" model="ir.ui.view">
        <field name="name">res.partner.form.view.pos.purchase.amount.cap</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="point_of_sale.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='point_of_sale']" position="inside">
                <field name="activate_purchase_limit"/>
                <field name="purchase_limit_amount" widget="monetary" invisible="activate_purchase_limit == False"/>
            </xpath>
        </field>
    </record>
</odoo>