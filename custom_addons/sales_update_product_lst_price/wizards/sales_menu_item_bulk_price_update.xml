<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_sales_bulk_price_update_wizard" model="ir.actions.act_window">
        <field name="name">Update Sales Prices</field>
        <field name="res_model">bulk.price.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="sale_bulk_price_update_view_form" model="ir.ui.view">
        <field name="name">sale.bulk.price.update.view.form</field>
        <field name="model">bulk.price.update</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="price_update_method" string="Price Update Method"/>
                    <field name="update_value" string="Price Update Value"/>
                </group>
                <notebook>
                    <page name="Products">
                        <field name="product_ids">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="current_price"/>
                                <field name="new_price"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="update_changes_in_price" type="object" string="Update" class="btn-primary"/>
<!--                    <button string="OK" special="cancel" class="btn-primary"/>-->
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="sale_menu_bulk_price_update_wizard" name="Bulk Price Update" parent="sale.product_menu_catalog"
              action="action_sales_bulk_price_update_wizard"/>

</odoo>