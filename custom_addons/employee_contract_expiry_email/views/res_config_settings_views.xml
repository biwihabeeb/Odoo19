<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_setting_contract_expiry_due_email_reminder" model="ir.ui.view">
        <field name="name">res.config.settings.view.setting.contract.expiry.due.email.reminder</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='contract_work_permit_expiration_notify']" position="inside">
                <setting string="Contract Expiry Email Reminder" help="Number of days prior to the contract end date that a reminder email is sent to the employee's manager.">
                    <field name="contract_expiration_due" class="w-25"/><span>Days</span>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>