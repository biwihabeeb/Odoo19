<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_form_view_smart_button_revisions" model="ir.ui.view">
        <field name="name">sale.order.form.view.smart.button.revisions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_revisions" type="object" class="oe_stat_button" icon="fa-pencil" invisible="revision_count == 0">
                    <field name="revision_count" widget="statinfo" string="Revisions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>