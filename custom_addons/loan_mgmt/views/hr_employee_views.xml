<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_employee_view_form_field_loan_not_allowed" model="ir.ui.view">
        <field name="name">hr.employee.view.form.field.loan.not.allowed</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='work_information']" position="inside">
                <group name="loan_details" string="Employee Loan">
                    <field name="loan_not_allowed"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>