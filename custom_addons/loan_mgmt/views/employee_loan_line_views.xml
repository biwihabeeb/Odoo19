<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_emploeyee_loan_line_view" model="ir.actions.act_window">
        <field name="name">Loan Lines</field>
        <field name="res_model">employee.loan.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="employee_loan_line_view_list" model="ir.ui.view">
        <field name="name">employee_loan_line_view_list</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="loan_id"/>
                <field name="amount"/>
                <field name="date"/>
                <field name="paid"/>
            </list>
        </field>
    </record>
</odoo>