<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_res_config_settings_attachemnt_required_field_view" model="ir.ui.view">
        <field name="name">purchase.res.config.settings.attachemnt.required.field.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting string="Attachments Required" help="Ensure that a purchase order cannot be confirmed unless at least one valid attachment is added.">
                    <field name="attachment_required"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>