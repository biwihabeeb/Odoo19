<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_no_attachment_warning_view" model="ir.ui.view">
        <field name="name">purchase.order.form.no.attachment.warning.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning" role="alert" invisible="not no_attachments_warning_message">
                    <field name="no_attachments_warning_message" class="fw-bold" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>