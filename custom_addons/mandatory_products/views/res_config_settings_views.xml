<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_setting_add_mandatory_products" model="ir.ui.view">
        <field name="name">res.config.settings.view.setting.add.mandatory.products</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='catalog_setting_container']" position="inside">
                <setting string="Add Associated Products" help="if enabled, when a product in order line has associated products, those products are also added to the order lines">
                    <field name="add_mandatory_products"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>